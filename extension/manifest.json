{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "version": "1.7.0",
  "description": "__MSG_appDesc__",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://api.pwnedpasswords.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "i18n.js",
        "strength.js",
        "sitecheck.js",
        "twofa.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Password Guard",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "default_locale": "en"
}