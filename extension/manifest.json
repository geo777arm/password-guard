{
  "manifest_version": 3,
  "name": "Password Guard — проверка паролей на утечки",
  "version": "1.0.0",
  "description": "Проверяет, не засветился ли пароль во взломанных базах, и предупреждает, если один пароль используется на разных сайтах.",
  "permissions": ["storage"],
  "host_permissions": ["https://api.pwnedpasswords.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["strength.js", "content.js"], "css": ["content.css"], "run_at": "document_idle", "all_frames": true }
  ],
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_popup": "popup.html", "default_title": "Password Guard", "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png" } }
}
